{
  "title": "Kafka Connect / Debezium — метрики",
  "uid": "kafka-connect-debezium",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Доступность Kafka Connect (Prometheus target up)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"kafka-connect\"}",
          "legendFormat": "kafka-connect up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Запущенные таски коннектора (connector-running-task-count)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "kafka_connect_connector_metrics_connector_running_task_count",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Проваленные таски коннектора (connector-failed-task-count)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "kafka_connect_connector_metrics_connector_failed_task_count",
          "legendFormat": "{{connector}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Скорость чтения изменений из Postgres (source-record-write-total, rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(kafka_connect_source_task_metrics_source_record_write_total[1m])",
          "legendFormat": "{{connector}}/{{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Среднее время между poll'ами задачи, мс (poll-batch-avg-time-ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "kafka_connect_source_task_metrics_poll_batch_avg_time_ms",
          "legendFormat": "{{connector}}/{{task}}",
          "refId": "A"
        }
      ]
    }
  ]
}
